# --- LLM providers (for writing Nepali captions) ---
# Only GEMINI_API_KEY and GROQ_API_KEY are required. The numbered extras are
# optional fallback keys, tried in order if an earlier one fails/rate-limits.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=

# --- Meta (Facebook Page + Instagram Business account) ---
# Long-lived Page access token with: pages_show_list, pages_read_engagement,
# pages_manage_posts, instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=your_meta_page_access_token
FB_PAGE_ID=your_facebook_page_id
IG_ACCOUNT_ID=your_instagram_business_account_id

# --- Optional tuning ---
MAX_POSTS_PER_RUN=6
MAX_ITEM_AGE_HOURS=36
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
